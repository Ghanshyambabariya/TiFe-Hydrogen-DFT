&CONTROL
  calculation = 'scf'
  prefix = 'TiFe_k_8x8x8'
  outdir = './tmp'
  pseudo_dir = './pseudo'
  tprnfor = .true.
  tstress = .true.
/
&SYSTEM
  ibrav = 0
  nat = 2
  ntyp = 2
  ecutwfc = 50
  occupations = 'smearing'
  smearing = 'mv'
  degauss = 0.02
  nspin = 2
  starting_magnetization(1) = 0.1
  starting_magnetization(2) = 0.3
/
&ELECTRONS
  conv_thr = 1.0d-8
  mixing_beta = 0.4
/
ATOMIC_SPECIES
Ti 47.867000 Ti.pbe-spn-kjpaw_psl.1.0.0.UPF
Fe 55.845000 Fe.pbe-spn-kjpaw_psl.1.0.0.UPF
CELL_PARAMETERS angstrom
   2.9700000000  0.0000000000  0.0000000000
   0.0000000000  2.9700000000  0.0000000000
   0.0000000000  0.0000000000  2.9700000000
ATOMIC_POSITIONS angstrom
  Ti  0.0000000000  0.0000000000  0.0000000000
  Fe  1.4850000000  1.4850000000  1.4850000000
K_POINTS automatic
  8 8 8 0 0 0
